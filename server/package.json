{
  "name": "@triage/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build --workspace @triage/shared && tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "eval": "tsx ../eval/run.ts"
  },
  "dependencies": {
    "@google/genai": "2.22.0",
    "@netlify/blobs": "^11.1.0",
    "@triage/shared": "file:../shared",
    "cors": "2.8.5",
    "dotenv": "16.5.0",
    "express": "5.2.1",
    "groq-sdk": "^1.6.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "serverless-http": "^4.0.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "5.0.3",
    "@types/pg": "^8.23.1",
    "vitest": "3.2.4"
  }
}
