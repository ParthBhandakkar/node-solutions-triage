# Runtime
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Provider: auto | ollama | gemini | groq | rules
LLM_PROVIDER=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Production persistence. Netlify uses Blobs when unset; use Postgres for high-volume deployments.
DATABASE_URL=
DB_POOL_MAX=10
# Comma-separated production origins; Netlify URL variables are also accepted.
CORS_ORIGINS=
# Optional shared secret for a deployed demo. Leave empty for local use.
DEMO_KEY=
# true masks email addresses and phone-like strings before cloud LLM calls.
REDACT_BEFORE_LLM=false
